{
  "public_base_url": {
    "description": "绑定服务公网地址",
    "type": "string",
    "default": "https://nikke.irises777.xyz"
  },
  "web_host": {
    "description": "绑定服务监听地址",
    "type": "string",
    "default": "0.0.0.0"
  },
  "web_port": {
    "description": "绑定服务容器内端口",
    "type": "int",
    "default": 6210
  },
  "binding_api_key": {
    "description": "创建绑定会话接口的Bearer密钥；留空时禁用该接口",
    "type": "string",
    "default": ""
  },
  "allow_group_bind": {
    "description": "允许在群聊生成绑定链接；存在链接被旁观者抢先使用的风险",
    "type": "bool",
    "default": false
  },
  "daily_hour": {
    "description": "每日任务开始小时（北京时间）",
    "type": "int",
    "default": 8
  },
  "daily_minute": {
    "description": "每日任务开始分钟",
    "type": "int",
    "default": 10
  },
  "summary_hour": {
    "description": "每日汇总小时（北京时间）",
    "type": "int",
    "default": 8
  },
  "summary_minute": {
    "description": "每日汇总分钟",
    "type": "int",
    "default": 30
  },
  "request_timeout": {
    "description": "BlaBlaLink 请求超时秒数",
    "type": "int",
    "default": 20
  },
  "max_concurrency": {
    "description": "账号任务最大并发数",
    "type": "int",
    "default": 2
  },
  "enable_daily_actions": {
    "description": "启用已验证的社区签到与领奖接口",
    "type": "bool",
    "default": false
  },
  "enable_announcement_push": {
    "description": "启用已由机器人管理员订阅的会话公告与截止提醒；默认关闭",
    "type": "bool",
    "default": false
  },
  "enable_cdk_redemption": {
    "description": "启用国际服CDK真实兑换；群聊命令会公开兑换码",
    "type": "bool",
    "default": false
  }
}
